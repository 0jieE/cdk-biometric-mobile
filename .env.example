# Copy this file to .env and fill in real values. .env is gitignored — never
# commit it. Loaded at build/run time with:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Without .env (or a misconfigured one), the app shows a "Missing build
# configuration" screen instead of a silent connection failure.

# The attendance backend's base URL (no trailing slash, no /api/v1).
# Ask whoever runs the backend for the current ngrok/tunnel or server URL.
API_BASE_URL=

# Firebase (push notifications). Optional — if left blank, Firebase.initializeApp
# fails gracefully and the app runs with push disabled (Profile shows "Push
# notifications: Not configured"). Get these from Firebase Console -> Project
# settings -> General -> Your apps -> Android app -> SDK config, or from
# android/app/google-services.json after `flutterfire configure` (see README).
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
